# Copy this file to .env and replace every placeholder before starting Compose.
# Use a long URL-safe password (letters and numbers) for POSTGRES_PASSWORD.
POSTGRES_DB=ipchat
POSTGRES_USER=ipchat
POSTGRES_PASSWORD=replace_with_random_url_safe_password

# Use at least 32 random bytes; do not reuse this value in another application.
JWT_SECRET=replace_with_at_least_32_random_bytes

# Generate a bcrypt hash with: go run ./cmd/hashadmin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Optional: comma-separated browser origins allowed to access the API.
ALLOWED_ORIGINS=

# OAuth is optional. Configure a provider only after registering its callback URL.
OAUTH_REDIRECT_BASE=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
